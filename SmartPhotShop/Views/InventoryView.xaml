<UserControl x:Class="SmartPhotShop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mah:DialogParticipation.Register="{Binding}"
             xmlns:local="clr-namespace:SmartPhotShop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Delete"
                    Width="100"
                    Margin="5"
                    x:Name="Delete"/>
        </StackPanel>
        <DataGrid x:Name="Items"
                  Grid.Row="1"
                  FontSize="18"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox VerticalAlignment="Center" 
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.IsAllSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox  VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sku" Width="*" Binding="{Binding Sku}"/>
                    <DataGridTextColumn Header="Product ID" 
                                    Width="*" Binding="{Binding ProductId}"/>
                    <DataGridTextColumn Header="Path"  Width="2*" Binding="{Binding Location}"/>
                </DataGrid.Columns>
            </DataGrid>
    </Grid>
</UserControl>
